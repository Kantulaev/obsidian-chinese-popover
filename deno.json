{
  "nodeModulesDir": "none",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "strict": true,
    "noImplicitOverride": false
  },
  "imports": {
    "obsidian": "./types/obsidian.d.ts",
    "@codemirror/view": "./types/codemirror.d.ts",
    "@codemirror/state": "./types/codemirror.d.ts",
    "moment": "./types/moment.d.ts"
  },
  "tasks": {
    "build": "deno run -A build.ts production",
    "dev": "deno run -A build.ts",
    "build-dict": "deno run --allow-read --allow-write scripts/build-dict.ts"
  }
}
