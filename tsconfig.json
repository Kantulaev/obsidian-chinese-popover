{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "obsidian": ["src/types/obsidian.d.ts"],
      "@codemirror/view": ["src/types/codemirror.d.ts"],
      "@codemirror/state": ["src/types/codemirror.d.ts"],
      "moment": ["src/types/moment.d.ts"]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020", "ESNext"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "build.ts"]
}

